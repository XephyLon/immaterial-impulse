# Space Grotesk is only the Expressive display font, and its package is
# unreachable/awkward to build in some regions - a hard depend there failed the
# whole install. Optional now: the shell falls back to another family when it is
# missing, and the Expressive font is settable in Settings > Appearance.
optdepends=(
  'otf-space-grotesk: the Expressive display font (set another in Settings if unavailable)'
)
