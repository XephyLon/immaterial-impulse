      "choices": [
        {
          "displayName": "Hide",
          "icon": "block",
          "value": "hide"
        },
        {
          "displayName": "Classic",
          "icon": "radio",
          "value": "classic"
        },
        {
          "displayName": "Thin",
          "icon": "line_end",
          "value": "thin"
        },
        {
          "displayName": "Medium",
          "icon": "eraser_size_2",
          "value": "medium"
        },
        {
          "displayName": "Bold",
          "icon": "eraser_size_4",
          "value": "bold"
        }
