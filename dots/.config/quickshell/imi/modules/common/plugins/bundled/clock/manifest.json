          {
            "key": "style",
            "in": [
              "cookie"
            ]
          },
          {
            "key": "styleLocked",
            "in": [
              "cookie"
            ]
          }
        ]
      },
      "group": "Cookie clock"
    },
    {
      "key": "cookieAiStyling",
      "type": "boolean",
      "label": "Auto styling with Gemini",
      "icon": "wand_stars",
      "default": false,
