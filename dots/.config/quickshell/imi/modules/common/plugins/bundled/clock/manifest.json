    },
    {
      "key": "quoteFollowClock",
      "type": "boolean",
      "label": "Follow clock font",
      "icon": "font_download",
      "default": false,
      "enabledWhen": "quoteEnable",
      "group": "Quote"
    },
    {
      "key": "quoteText",
      "type": "text",
      "label": "Text",
      "icon": "format_quote",
      "default": "",
