          {
            "key": "style",
            "in": [
              "cookie"
            ]
          },
          {
            "key": "styleLocked",
            "in": [
              "cookie"
            ]
          }
        ]
      },
      "group": "Cookie clock"
    },
    {
      "key": "cookieSides",
      "type": "number",
      "label": "Sides",
      "icon": "add_triangle",
      "default": 14,
      "from": 0,
      "to": 40,
